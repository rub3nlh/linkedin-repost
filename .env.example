# LinkedIn Developer App credentials
# Create one at https://www.linkedin.com/developers/apps
# Add products: "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Must match exactly the Authorized Redirect URL configured in the LinkedIn app.
# Local: http://localhost:3000/api/auth/callback
# Heroku: https://<your-app>.herokuapp.com/api/auth/callback
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Shared password for the comms team to use the form.
ADMIN_PASSWORD=change-me

# --- Token data filled AFTER the OAuth flow ---
# After clicking "Conectar con LinkedIn" and authorizing, the /connected page
# will show ready-to-paste values. Copy them here for local dev, or set them
# in Heroku with `heroku config:set ...`.
LINKEDIN_TOKEN=
LINKEDIN_SUB=
LINKEDIN_TOKEN_EXPIRES_AT=
LINKEDIN_NAME=
LINKEDIN_PICTURE=
